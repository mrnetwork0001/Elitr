# Secrets: never send to the build context
.env
.env.*
**/.env
**/.env.*
*.pem
*.key
keystore/
wallets/

# Deps and build output (rebuilt inside the image)
**/node_modules
**/.next
**/dist
**/out
**/*.tsbuildinfo

# Runtime data (mounted as a volume)
data/
**/*.log

# Not needed in images
.git
.github
docs/
*.md
!apps/**/README.md
docker-compose*.yml
**/Dockerfile
.dockerignore
.DS_Store
.vscode
.idea
.claude
docker/
