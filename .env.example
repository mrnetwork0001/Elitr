# Copy to .env (never commit .env). One file at repo root is shared by all apps.

# --- Binance Web3 API (https://web3.binance.com/en/dev-portal) ---
# The analyst's key needs the "B402 Payments" permission ticked.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# --- Analyst agent (b402 merchant) ---
ANALYST_PORT=4001
# Must equal the write-once payTo set during B402 onboarding in the dev portal
ANALYST_PAY_TO=
# Price per signal, in smallest units of the payment asset (18 decimals: 0.01 = 10000000000000000)
ANALYST_PRICE_WEI=10000000000000000
# Payment asset on BSC: USDT 0x55d3...7955 (Permit2) | U 0xcE24...6666 (EIP-3009) | USD1 0x8d0D...0B0d (EIP-3009)
ANALYST_PAYMENT_ASSET=0x55d398326f99059fF775485246999027B3197955
# permit2-exact (USDT/USDC, needs one-time approve to Permit2) | eip3009 (U/USD1, no approval)
ANALYST_PAYMENT_METHOD=permit2-exact
# Only needed if /supported returns several matching kinds (matches extra.name)
ANALYST_PAYMENT_TOKEN_NAME=
ANALYST_PAYMENT_TIMEOUT_SEC=300
# Public URL put in the 402 resource field (defaults to request host)
ANALYST_PUBLIC_URL=
# LLM for scoring — pick ONE:
#  (a) 0G Compute Router (Claude over the Anthropic Messages format, billed in 0G):
#      key from https://pc.0g.ai (Dashboard -> API Keys), sent as Authorization: Bearer
ANTHROPIC_BASE_URL=https://router-api.0g.ai
ANTHROPIC_AUTH_TOKEN=
ANALYST_MODEL=claude-sonnet-5
# How long a news call is meant to hold — the trader scores it after this
ANALYST_HORIZON_SEC=3600

# --- Flow analyst (on-chain PancakeSwap flow, same process as the news analyst) ---
FLOW_ANALYST_PORT=4003
# Optional: separate payee / price (default to the news analyst's)
FLOW_ANALYST_PAY_TO=
FLOW_ANALYST_PRICE_WEI=
FLOW_ANALYST_PUBLIC_URL=
FLOW_HORIZON_SEC=1800
# Public RPCs only serve recent logs; raise only with an archive-capable FLOW_RPC_URL
FLOW_LOOKBACK_SEC=3600
FLOW_MIN_SWAPS=5
FLOW_LARGE_TRADE_USD=2000
# Comma-separated; must support eth_getLogs (bsc-dataseed does not)
FLOW_RPC_URL=https://bsc-rpc.publicnode.com
FLOW_LOGS_CHUNK_BLOCKS=2000
#  (b) Anthropic directly: leave the two lines above empty and set
ANTHROPIC_API_KEY=
#      ANALYST_MODEL=claude-haiku-4-5
SIGNAL_CACHE_SEC=120

# --- Execution agent ---
EXECUTION_PORT=4002
# /cycle and /kill are unauthenticated — keep on localhost unless behind auth
EXECUTION_HOST=127.0.0.1
# USD per trade (defaults to RISK_MAX_TRADE_USD)
EXECUTION_TRADE_USD=
EXECUTION_MIN_BNB_GAS=0.001
EXECUTION_MEV_PROTECTION=1
# Optional override of CURATED_B402_SPENDERS (comma-separated)
B402_TRUSTED_SPENDERS=
# Where state/events are stored (default <repo>/data)
EXECUTION_DATA_DIR=
# All analysts the trader can buy from (id=url, comma-separated)
ANALYSTS=analyst=http://localhost:4001,analyst-flow=http://localhost:4003
ANALYST_URL=http://localhost:4001
# Required for POST /cycle and /kill whenever EXECUTION_HOST is not localhost
CONTROL_TOKEN=
# Dedicated hot wallet for the agent — fund with small amounts only
EXECUTION_PRIVATE_KEY=
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
LOOP_INTERVAL_SEC=900
# Simulate only until this is set to 1. Quotes, prices and simulations are always real.
LIVE_TRADING=0

# --- ERC-8004 on-chain identity & reputation (see docs/agent-studio.md) ---
# Canonical registries default for BSC mainnet (56) / testnet (97)
ERC8004_CHAIN_ID=56
ERC8004_RPC_URL=
ERC8004_IDENTITY_REGISTRY=
ERC8004_REPUTATION_REGISTRY=
# Filled in after `pnpm --filter @elitr/identity register -- --subject <id> --yes`
ERC8004_AGENT_ID_ANALYST=
ERC8004_AGENT_ID_ANALYST_FLOW=
ERC8004_AGENT_ID_EXECUTION=
# Owner wallet(s) of the analysts — MUST differ from EXECUTION_PRIVATE_KEY (no self-feedback)
ANALYST_OWNER_PRIVATE_KEY=
ANALYST_FLOW_OWNER_PRIVATE_KEY=
EXECUTION_PUBLIC_URL=
# 1 = trader posts each analyst's accuracy on-chain after scoring (costs gas, ~0.000006 BNB each)
ERC8004_POST_FEEDBACK=0

# --- Risk limits (see packages/shared/src/risk.ts) ---
RISK_MAX_TRADE_USD=5
RISK_MAX_POSITION_USD=25
RISK_MAX_DAILY_SPEND_USD=25
RISK_MAX_SLIPPAGE_BPS=100
RISK_MIN_LIQUIDITY_USD=50000
RISK_MIN_CONFIDENCE=65
RISK_MIN_GAP_BPS=50
RISK_MAX_SIGNAL_AGE_SEC=300
RISK_MAX_DAILY_DATA_USD=2
RISK_MAX_PORTFOLIO_USD=50
RISK_TAKE_PROFIT_BPS=300
RISK_STOP_LOSS_BPS=200
RISK_EXIT_ON_BEARISH=1
# Pause paying an analyst whose trust falls below this after N scored signals
RISK_MIN_ANALYST_TRUST=0.45
RISK_MIN_ANALYST_SAMPLES=10
KILL_SWITCH=0

# --- Dashboard ---
NEXT_PUBLIC_ANALYST_URL=http://localhost:4001
NEXT_PUBLIC_EXECUTION_URL=http://localhost:4002
NEXT_PUBLIC_FLOW_ANALYST_URL=http://localhost:4003
DASHBOARD_ORIGIN=http://localhost:3000
